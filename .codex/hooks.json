{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__chrome[-_]devtools__",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/chrome-gate.py\"",
            "statusMessage": "chrome skill gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "TQ_HOOK_RUNTIME=codex python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/test-quality-reminder.py\"",
            "statusMessage": "Checking test run + vetting"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/doc-freshness-reminder.py\"",
            "statusMessage": "Doc-freshness close reminder"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/spec-quality-reminder.py\"",
            "statusMessage": "Spec-quality reminder"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/spec-conformance-gate.py\"",
            "statusMessage": "Spec-conformance gate"
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/doc-freshness-reminder.py\"",
            "statusMessage": "Doc-freshness close reminder"
          }
        ]
      },
      {
        "matcher": "^mcp__RepoPromptCE__(app_settings|agent_manage|ask_oracle)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/model-roster-reminder.py\"",
            "statusMessage": "Model-roster drift check"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TQ_HOOK_RUNTIME=codex python3 \"$(git rev-parse --show-toplevel)/.agents/hooks/test-quality-reminder.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
